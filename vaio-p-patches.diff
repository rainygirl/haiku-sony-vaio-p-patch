diff --git a/build/jam/DefaultBuildProfiles b/build/jam/DefaultBuildProfiles
index 1624aa58f8..aba7419185 100644
--- a/build/jam/DefaultBuildProfiles
+++ b/build/jam/DefaultBuildProfiles
@@ -119,6 +119,11 @@ rule DefineDefaultBuildProfiles
 			for architectureObject in [ MultiArchSubDirSetup ] {
 				on $(architectureObject) {
 					AddHaikuImageSystemPackages openssl3 ;
+					# libfreetype pulls in libharfbuzz at runtime, but
+					# harfbuzz isn't in the default nightly image, so every
+					# boot logs "Cannot open file libharfbuzz.so.0 (needed
+					# by libfreetype.so.6.20.4)". Ship it.
+					AddHaikuImageSystemPackages harfbuzz ;
 				}
 			}
 
@@ -160,7 +165,42 @@ rule DefineDefaultBuildProfiles
 					nano_x86@secondary_x86
 					p7zip_x86@secondary_x86
 					xz_utils_x86@secondary_x86
+					# Personal additions: python3.14_x86 and vim_x86.
+					# python3.14_x86 comes from the repository like everything
+					# else here. It, xz_utils_x86, expat_x86, gettext_x86_libintl
+					# and zlib_x86 used to be injected as plain files because the
+					# pinned build-packages snapshot carried versions too old to
+					# resolve at boot; the RenkuOS tree's x86_gcc2 repository
+					# definition is synced (88b7b8b350) and now lists the same or
+					# newer versions, so that reason is gone. vim_x86 is still not
+					# in the repository and is injected below -- and an injected
+					# file bypasses dependency resolution, so its requirements
+					# are listed here explicitly.
+					python3.14_x86@secondary_x86
+					file
+					bzip2_x86@secondary_x86
+					expat_x86@secondary_x86
+					gcc_x86_syslibs@secondary_x86
+					gettext_x86_libintl@secondary_x86
+					libedit_x86@secondary_x86
+					libffi_x86@secondary_x86
+					libiconv_x86@secondary_x86
+					ncurses6_x86@secondary_x86
+					openssl3_x86@secondary_x86
+					sqlite_x86@secondary_x86
+					zlib_x86@secondary_x86
+					zstd_x86@secondary_x86
 				}@
+				# harfbuzz isn't in the default nightly image, so gcc2's
+				# libfreetype -- which was linked against it -- logs
+				# "Cannot open file libharfbuzz.so.0" on every boot. There's
+				# no prebuilt harfbuzz package for the primary gcc2
+				# architecture though (only the secondary_x86 one), so this
+				# can only be silenced for !gcc2 primary archs; on gcc2
+				# hybrids libfreetype's harfbuzz-based shaping stays
+				# unavailable (cosmetic -- FreeType degrades gracefully
+				# without it).
+				!gcc2 @{ harfbuzz }@
 				;
 			AddHaikuImageSourcePackages
 				nano
@@ -169,6 +209,65 @@ rule DefineDefaultBuildProfiles
 
 			AddOptionalHaikuImagePackages Development Git ;
 
+			# Personal addition: vim_x86 is not in the x86_gcc2 repository,
+			# so its .hpkg (fetched from the live HaikuPorts repository by
+			# build-vaio-p-iso.sh) is dropped into /system/packages as a plain
+			# file; with no packages activation file on a fresh image,
+			# packagefs activates everything found in that directory at boot.
+			local vaioPExtraPackages =
+				vim_x86-9.1.1618-1-x86_gcc2.hpkg ;
+			# Derived from HAIKU_TOP rather than written out, so this works
+			# wherever the tree is checked out. It used to be the absolute
+			# /haiku-build/vaio-p-packages, which is where the build
+			# container mounts this volume -- correct there and nowhere
+			# else, so the image target simply could not be made outside
+			# that container ("don't know how to make
+			# vim_x86-...-x86_gcc2.hpkg", once per file). The packages
+			# directory sits beside the source tree in both places, which
+			# is what this expresses.
+			SEARCH on $(vaioPExtraPackages)
+				= [ FDirName $(HAIKU_TOP) .. vaio-p-packages ] ;
+
+			# HTML5 video in WebPositive, with H.264 decoded on the GMA500
+			# (haiku-webpositive-msvdx; pkgman.rainygirl.com's
+			# x86_gcc2-webpositive repository, fetched by build-vaio-p-iso.sh).
+			# HaikuWebKit 1.9.19 never registers its media engine, so without
+			# this no <video> plays at all. haikuwebkit_x86 1.9.19-22 is the
+			# same 1.9.19 the repository's -2 is, with that fixed;
+			# msvdx_media_x86 is the Media Kit decoder add-on, whose
+			# post-install script runs in first-boot processing.
+			#
+			# These go through AddPackageFilesToHaikuImage, not
+			# AddFilesToHaikuImage like vim_x86 above: that puts them on the
+			# system package list the image build resolves dependencies
+			# against, so WebPositive's lib:libwebkitlegacy_x86 is met by
+			# -22 and the repository's -2 is not added beside it, and the
+			# add-on's FFmpeg libraries are pulled in from the repository.
+			local vaioPVideoPackages =
+				haikuwebkit_x86-1.9.19-22-x86_gcc2.hpkg
+				msvdx_media_x86-1.0.0-1-x86_gcc2.hpkg
+				msvdx_firmware-0.30-1-any.hpkg
+				webpositive_hwvideo-1.0.0-1-x86_gcc2.hpkg ;
+			SEARCH on $(vaioPVideoPackages)
+				= [ FDirName $(HAIKU_TOP) .. vaio-p-packages ] ;
+
+			# And only for a build that actually has an x86_gcc2 secondary
+			# architecture. Every file here is an x86_gcc2 package: the
+			# repository packages above are already gated behind gcc2 @{ }@
+			# for that reason, but this injection was not, so a plain x86 or
+			# x86_64 image got a set of packages whose architecture it does
+			# not have. They cannot resolve at boot, and there is nothing
+			# for them to be a dependency of.
+			if x86_gcc2 in $(HAIKU_PACKAGING_ARCHS) {
+				AddFilesToHaikuImage system packages
+					: $(vaioPExtraPackages) ;
+				AddPackageFilesToHaikuImage system packages
+					: $(vaioPVideoPackages) ;
+			} else {
+				Echo "vaio-p: skipping the x86_gcc2 package injection,"
+					"HAIKU_PACKAGING_ARCHS is $(HAIKU_PACKAGING_ARCHS)" ;
+			}
+
 			# WebPositive can only built for x86_gcc2, x86 and x86_64
 			if $(HAIKU_PACKAGING_ARCHS) in x86_gcc2 x86 x86_64 {
 				AddOptionalHaikuImagePackages WebPositive ;
diff --git a/build/jam/images/definitions/regular b/build/jam/images/definitions/regular
index ad4bbf368d..aa3614cdcf 100644
--- a/build/jam/images/definitions/regular
+++ b/build/jam/images/definitions/regular
@@ -189,6 +189,14 @@ SYSTEM_ADD_ONS_ACCELERANTS += [ FFilterByBuildFeatures
 	x86 @{
 		3dfx.accelerant
 		neomagic.accelerant
+		# VAIO P: Intel SCH US15W (Poulsbo, "GMA500"). Its drawing engine is
+		# a PowerVR SGX535 with no public documentation, so only the display
+		# half -- which is Intel's and i915-shaped -- is driven: the mode the
+		# BIOS set is kept and the hardware cursor plane is used. Without it
+		# the machine falls back to vesa, which has no cursor hooks, so
+		# app_server saves, draws and restores the area under the pointer on
+		# every mouse move. On a 1.33 GHz Atom that is visible.
+		poulsbo.accelerant
 	}@ # x86
 ] ;
 
@@ -304,6 +312,9 @@ SYSTEM_ADD_ONS_DRIVERS_GRAPHICS += [ FFilterByBuildFeatures
 	x86 @{
 		3dfx
 		neomagic
+		# See the note next to poulsbo.accelerant above. Poulsbo only ever
+		# shipped paired with 32-bit Atom Z5xx parts, so x86 only.
+		poulsbo
 	}@ # x86
 ] ;
 
@@ -338,6 +349,7 @@ SYSTEM_ADD_ONS_DRIVERS_POWER += [ FFilterByBuildFeatures
 	acpi_ac@x86,x86_64
 	acpi_battery@x86,x86_64
 	acpi_lid@x86,x86_64
+	sony_ec@x86,x86_64
 ] ;
 
 SYSTEM_ADD_ONS_FILE_SYSTEMS +=
@@ -387,3 +399,14 @@ AddDirectoryToHaikuImage home config settings touchpad ;
 local shortcutsSettingsFile = <settings>shortcuts_settings ;
 SEARCH on $(shortcutsSettingsFile) = [ FDirName $(HAIKU_TOP) data settings ] ;
 AddFilesToHaikuImage home config settings : $(shortcutsSettingsFile) ;
+
+# VAIO P: Intel Atom (Bonnell, family 06 model 1c stepping 2) microcode
+# update. The boot loader's ucode_load() only searches
+# system/non-packaged/data/firmware/intel-ucode/<fam>-<model>-<stepping>,
+# and without it this CPU runs on its shipped microcode forever
+# ("ucode_load: couldn't find microcode" every boot).
+local vaioPUcodeFile = 06-1c-02 ;
+SEARCH on $(vaioPUcodeFile)
+	= [ FDirName $(HAIKU_TOP) data system data firmware intel-ucode ] ;
+AddFilesToHaikuImage system non-packaged data firmware intel-ucode
+	: $(vaioPUcodeFile) ;
diff --git a/build/jam/packages/Haiku b/build/jam/packages/Haiku
index 5de3de80e2..5b6d84aef7 100644
--- a/build/jam/packages/Haiku
+++ b/build/jam/packages/Haiku
@@ -102,10 +102,22 @@ AddFilesToPackage add-ons kernel interrupt_controllers :
 	;
 AddFilesToPackage add-ons kernel power cpufreq :
 	amd_pstates@x86,x86_64
+	# Legacy Intel Enhanced SpeedStep, via ACPI _PSS/_PCT + IA32_PERF_CTL.
+	# Covers pre-HWP EST CPUs that intel_pstates rejects (e.g. the
+	# first-gen Atom in the VAIO P), which otherwise run pinned at a
+	# single frequency ("no valid cpufreq module found").
+	intel_est@x86,x86_64
 	intel_pstates@x86,x86_64
 	;
 AddFilesToPackage add-ons kernel power cpuidle :
 	x86_cstates@x86,x86_64
+	# ACPI _CST-based C-states. Needed for CPUs that don't enumerate
+	# their MWAIT C-states through CPUID leaf 5 (which x86_cstates
+	# requires) but do declare them via ACPI -- e.g. the first-gen Atom
+	# (Bonnell) in the VAIO P, where x86_cstates alone fails with "no
+	# valid cpuidle module found" and the CPU never enters a deep idle
+	# state.
+	x86_acpi_cstates@x86,x86_64
 	;
 
 if $(TARGET_ARCH) = x86 || $(TARGET_ARCH) = x86_64 {
