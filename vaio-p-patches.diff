+	if (ticks - sc->sc_bmiss_last_tick > 30 * hz)
+		sc->sc_bmiss_count = 0;
+	sc->sc_bmiss_last_tick = ticks;
+	sc->sc_bmiss_count++;
+
+	if (sc->sc_bmiss_count >= 2) {
+		device_printf(sc->sc_dev,
+		    "repeated beacon miss recovery, power-cycling the "
+		    "adapter\n");
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D3);
+		DELAY(50000);
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D0);
+		pci_enable_busmaster(sc->sc_dev);
