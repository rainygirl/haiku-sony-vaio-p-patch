+diff --git a/headers/os/device/USBKit.h b/headers/os/device/USBKit.h
+index 1e82f83f5a..2a7e7e556b 100644
+--- a/headers/os/device/USBKit.h
++++ b/headers/os/device/USBKit.h
+@@ -350,6 +350,19 @@ public:
+ 										usb_iso_packet_descriptor *packetDescriptors,
+ 										uint32 packetCount)	const;
+ 
++		// QueueIsochronous()/WaitIsochronous() split IsochronousTransfer()
++		// into a non-blocking submit step (returns a request ID) and a
++		// separate blocking wait step, so a caller can have more than one
++		// isochronous transfer genuinely outstanding with the host
++		// controller at once -- queue several, then wait on each in
