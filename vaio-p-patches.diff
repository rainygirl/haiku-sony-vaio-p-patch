diff --git a/headers/private/drivers/backlight.h b/headers/private/drivers/backlight.h
new file mode 100644
index 0000000000..5b5572699c
--- /dev/null
+++ b/headers/private/drivers/backlight.h
@@ -0,0 +1,43 @@
+/*
+ * Copyright 2026, Haiku, Inc. All Rights Reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _BACKLIGHT_MODULE_H
+#define _BACKLIGHT_MODULE_H
+
+
+#include <module.h>
+
+
+/*!	Optional panel-backlight control, published by whatever machine-specific
+	driver actually owns the backlight on a given system.
+
+	This exists because on some laptops the backlight is not reachable through
+	the graphics driver at all. Poulsbo (Intel SCH) is the motivating case: its
+	panel brightness lives in a chipset register that the VESA BIOS DPMS call
+	does not touch, so blanking the screen leaves the backlight fully lit and
+	the panel merely displaying black -- most of the power still burned, which
+	on a netbook is the single biggest battery lever there is.
+
+	A graphics driver that blanks the display can look this module up with
+	get_module() and, if it is present, ask for the backlight to follow. It is
+	deliberately optional: get_module() simply fails on machines where nothing
+	publishes it, and the graphics driver carries on exactly as before.
+*/
+
+#define BACKLIGHT_MODULE_NAME "generic/backlight/v1"
+
+
+typedef struct backlight_module_info {
+	module_info info;
+
+	/*!	Switches the panel backlight off, or restores it to the level it was
+		at when it was last switched off. Implementations are expected to be
+		idempotent: turning it off twice, or on when it is already on, must
+		not lose the saved level.
+	*/
+	status_t (*set_power)(bool on);
+} backlight_module_info;
+
+
+#endif	/* _BACKLIGHT_MODULE_H */
