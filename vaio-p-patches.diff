+/*!	Copies the trampoline into place and builds the gdt it loads. Contents are
+	static, so this can run before the kernel is loaded.
+*/
+static void
+smp_setup_trampoline(void)
+{
+	memcpy((char *)kTrampolineCode, (const void*)&smp_trampoline,
+		(uint32)&smp_trampoline_end - (uint32)&smp_trampoline);
+
+	// gdt descriptor at the bottom of the stack page, gdt right behind it
+	*((uint16 *)kTrampolineStack) = 0x18 - 1;
+	*((uint32 *)(kTrampolineStack + 2)) = kTrampolineStack + 8;
+
+	segment_descriptor* tempGDT
+		= (segment_descriptor*)&((uint32 *)kTrampolineStack)[2];
+	clear_segment_descriptor(&tempGDT[0]);
+	set_segment_descriptor(&tempGDT[1], 0, 0xffffffff, DT_CODE_READABLE,
+		DPL_KERNEL);
+	set_segment_descriptor(&tempGDT[2], 0, 0xffffffff, DT_DATA_WRITEABLE,
+		DPL_KERNEL);
+}
+
+
+/*!	Per-IPI record of what the local APIC actually did.
+
+	Measured 2026-08-19: all four sends complete in 0 us with esr 0x0, and the
+	sequence reports "completed on attempt 1", yet the whole call still takes
+	211 ms against 10.4 ms of spin(). So the missing ~200 ms is neither a
+	delivery-status timeout nor the spins -- it is wall-clock lost between the
+	sample points, which is what an SMI storm looks like from inside the
+	loader. This machine's BIOS is known never to acknowledge the EHCI legacy
+	handoff (see "Early EHCI BIOS handoff"), so USB legacy emulation is still
+	running on SMIs throughout. sSegmentUs below times each segment separately
+	to find where it goes.
+*/
+struct ipi_step_trace {
+	const char*	name;
+	uint32		writtenIcr;
+	uint32		readbackIcr;
+	uint32		esr;
+	uint32		elapsedUs;
+	bool		timedOut;
+};
+
+static const uint32 kMaxIPITrace = 12;
+static ipi_step_trace sIpiTrace[kMaxIPITrace];
+static uint32 sIpiTraceCount;
+
+// Microseconds spent in each segment of one INIT/SIPI sequence, by the
+// loader's own TSC clock. Indices: 0 esr-clear, 1 init-assert write, 2
+// init-assert wait, 3 init-deassert write, 4 init-deassert wait, 5 spin(10000),
+// 6 sipi-1 write, 7 sipi-1 spin(200), 8 sipi-1 wait, 9 sipi-2 write,
+// 10 sipi-2 spin(200), 11 sipi-2 wait.
+static uint32 sSegmentUs[12];
+
+// Which slice of the INIT-to-SIPI wait the 200 ms stall lands in, if any.
+static uint32 sStallSlice[4];
+static uint32 sStallSliceUs[4];
+static uint32 sStallSliceCount;
+
+// How many wake attempts were spoiled by a stall landing in the INIT-to-SIPI
+// wait. Perfectly predicts an AP that does not come up.
+static uint32 sStalledAttempts;
+
+// Kept for smp_add_safemode_menus(), which runs much later and reports these.
+static uint32 sEarlyWakeAttempt;
+static uint32 sEarlyWakeMaxAttempts;
+static const char* const kSegmentName[12] = {
+	"esr-clear", "init-assert-write", "init-assert-wait",
+	"init-deassert-write", "init-deassert-wait", "spin10ms",
+	"sipi1-write", "sipi1-spin200", "sipi1-wait",
+	"sipi2-write", "sipi2-spin200", "sipi2-wait"
+};
+
+#define SEGMENT_BEGIN()		bigtime_t segStart = system_time()
+#define SEGMENT_END(index)	sSegmentUs[index] += (uint32)(system_time() \
+								- segStart); segStart = system_time()
+
+
+/*!	Bounded wait for the local APIC to finish sending, recording how long it
+	took and what the ICR and error status looked like afterwards.
+*/
+static bool
+smp_wait_for_delivery(const char* name, uint32 writtenIcr)
+{
+	bigtime_t start = system_time();
+
+	uint32 timeout = kIPIDeliveryTimeout;
+	while ((apic_read(APIC_INTR_COMMAND_1) & APIC_DELIVERY_STATUS) != 0
+			&& --timeout != 0) {
+		asm volatile ("pause;");
+	}
+
+	uint32 elapsedUs = (uint32)(system_time() - start);
+	uint32 readback = apic_read(APIC_INTR_COMMAND_1);
+
+	// The error status register latches on write, so write-then-read is the
+	// only way to see the errors raised by the send that just happened.
+	apic_write(APIC_ERROR_STATUS, 0);
+	uint32 esr = apic_read(APIC_ERROR_STATUS);
+
+	if (sIpiTraceCount < kMaxIPITrace) {
+		ipi_step_trace& step = sIpiTrace[sIpiTraceCount++];
+		step.name = name;
+		step.writtenIcr = writtenIcr;
+		step.readbackIcr = readback;
+		step.esr = esr;
+		step.elapsedUs = elapsedUs;
+		step.timedOut = timeout == 0;
+	}
+
+	return timeout != 0;
+}
+
+
+/*!	One INIT assert/de-assert plus the startup IPIs, with every wait bounded.
+	Returns false if a send never completed.
+*/
+static bool
+smp_send_init_sipi(uint32 cpu)
+{
+	uint32 apicID = gKernelArgs.arch_args.cpu_apic_id[cpu];
+	uint32 config;
+
+	SEGMENT_BEGIN();
+
+	if (gKernelArgs.arch_args.cpu_apic_version[cpu] & 0xf0) {
+		apic_write(APIC_ERROR_STATUS, 0);
+		apic_read(APIC_ERROR_STATUS);
+	}
+
+	SEGMENT_END(0);
+
+	// INIT, asserted then de-asserted
+	for (int32 phase = 0; phase < 2; phase++) {
+		config = (apic_read(APIC_INTR_COMMAND_2) & APIC_INTR_COMMAND_2_MASK)
+			| (apicID << 24);
+		apic_write(APIC_INTR_COMMAND_2, config);
+
+		config = (apic_read(APIC_INTR_COMMAND_1) & 0xfff00000)
+			| APIC_TRIGGER_MODE_LEVEL | APIC_DELIVERY_MODE_INIT
+			| (phase == 0 ? APIC_INTR_COMMAND_1_ASSERT : 0);
+		apic_write(APIC_INTR_COMMAND_1, config);
+
+		SEGMENT_END(phase == 0 ? 1 : 3);
+
+		if (!smp_wait_for_delivery(
+				phase == 0 ? "init-assert" : "init-deassert", config)) {
+			return false;
+		}
+
+		SEGMENT_END(phase == 0 ? 2 : 4);
+	}
+
+	// The 10 ms the MP init protocol asks for between INIT and SIPI, sliced so
+	// the 200 ms stall that lands in here can be located. Measured: baseline
+	// 10 ms spins are exact to the microsecond, an INIT to a bogus APIC id
+	// costs nothing, and a *second* INIT to id 1 costs nothing -- only the
+	// first INIT of the boot is followed by this stall. That is what a core
+	// resetting its sibling thread looks like from the thread that is still
+	// running, and it means something is there to reset.
+	for (uint32 slice = 0; slice < 20; slice++) {
+		bigtime_t sliceStart = system_time();
+		spin(500);
+		uint32 sliceUs = (uint32)(system_time() - sliceStart);
+		if (sliceUs > 2000 && sStallSliceCount < 4) {
+			sStallSlice[sStallSliceCount] = slice;
+			sStallSliceUs[sStallSliceCount] = sliceUs;
+			sStallSliceCount++;
+		}
+	}
+
+	SEGMENT_END(5);
+
+	uint32 numStartups
+		= (gKernelArgs.arch_args.cpu_apic_version[cpu] & 0xf0) ? 2 : 0;
+	for (uint32 j = 0; j < numStartups; j++) {
+		apic_write(APIC_ERROR_STATUS, 0);
+
+		config = (apic_read(APIC_INTR_COMMAND_2) & APIC_INTR_COMMAND_2_MASK)
+			| (apicID << 24);
+		apic_write(APIC_INTR_COMMAND_2, config);
+
+		config = (apic_read(APIC_INTR_COMMAND_1) & 0xfff0f800)
+			| APIC_DELIVERY_MODE_STARTUP | (kTrampolineCode >> 12);
+		apic_write(APIC_INTR_COMMAND_1, config);
+
+		SEGMENT_END(j == 0 ? 6 : 9);
+
+		spin(200);
+
+		SEGMENT_END(j == 0 ? 7 : 10);
+
+		if (!smp_wait_for_delivery(j == 0 ? "sipi-1" : "sipi-2", config))
+			return false;
+
+		SEGMENT_END(j == 0 ? 8 : 11);
+	}
+
+	return true;
+}
