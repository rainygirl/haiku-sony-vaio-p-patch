--- a/headers/private/kernel/kernel.h
+++ b/headers/private/kernel/kernel.h
@@ -89,8 +89,15 @@ is_user_address_range(const void* addr, size_t size)
 
 
 #define CHECK_BIT(a, b) ((a) & (1 << (b)))
-#define SET_BIT(a, b) ((a) | (1 << (b)))
-#define CLEAR_BIT(a, b) ((a) & (~(1 << (b))))
+// SET_BIT/CLEAR_BIT take a bitmask in `b` (not a bit index), matching
+// GET_BIT/TOGGLE_BIT below -- their only caller (the h2 Bluetooth USB
+// transport driver) passes pre-shifted bt_transport_status_t constants
+// like RUNNING = (1<<1). The previous "(1 << (b))" definitions silently
+// shifted an already-shifted mask a second time, so e.g. SET_BIT(state,
+// RUNNING) set bit 0x4 while GET_BIT(state, RUNNING) checked bit 0x2 --
+// the RUNNING flag could never be observed as set once it was "set".
+#define SET_BIT(a, b) ((a) | (b))
+#define CLEAR_BIT(a, b) ((a) & (~(b)))
 #define GET_BIT(a, b) ((a & b) != 0)
 #define TOGGLE_BIT(a, b) (a ^= b)
 
