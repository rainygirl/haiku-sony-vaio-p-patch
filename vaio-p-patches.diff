+	 * recoveries are spread across reassociations rather than arriving in a
+	 * burst. Requiring both a higher count and that the run has actually
+	 * lasted a while separates the two: a starvation burst is dense and
+	 * short, a broken radio keeps coming back over minutes.
+	 */
+	if (ticks - sc->sc_bmiss_last_tick > 120 * hz)
+		sc->sc_bmiss_count = 0;
+	if (sc->sc_bmiss_count == 0)
+		sc->sc_bmiss_first_tick = ticks;
+	sc->sc_bmiss_last_tick = ticks;
+	sc->sc_bmiss_count++;
+
+	if (sc->sc_bmiss_count >= 4
+			&& ticks - sc->sc_bmiss_first_tick >= 30 * hz) {
+		device_printf(sc->sc_dev,
+		    "repeated beacon miss recovery, power-cycling the "
+		    "adapter\n");
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D3);
+		DELAY(50000);
+		pci_set_powerstate(sc->sc_dev, PCI_POWERSTATE_D0);
+		pci_enable_busmaster(sc->sc_dev);
+		sc->sc_bmiss_count = 0;
+	}
+
 	/*
 	 * Do a reset upon any beacon miss event.
 	 *
@@ -2516,8 +2564,8 @@ ath_bmiss_proc(void *arg, int pending)
 		    "bb hang detected (0x%x), resetting\n", hangs);
 	} else {
 		ath_reset(sc, ATH_RESET_NOLOSS, HAL_RESET_FORCE_COLD);
-		ieee80211_beacon_miss(&sc->sc_ic);
 	}
+	ieee80211_beacon_miss(&sc->sc_ic);
 
 	/* Force a beacon resync, in case they've drifted */
 	sc->sc_syncbeacon = 1;
