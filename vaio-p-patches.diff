+/*!	Returns whether the file at \a ref carries the application signature
+	\a signature.
+*/
+static bool
+app_has_signature(const entry_ref& ref, const char* signature)
+{
+	BFile file;
+	if (file.SetTo(&ref, B_READ_ONLY) != B_OK)
+		return false;
+
+	BAppFileInfo appFileInfo;
+	if (appFileInfo.SetTo(&file) != B_OK)
+		return false;
+
+	char foundSignature[B_MIME_TYPE_LENGTH];
+	if (appFileInfo.GetSignature(foundSignature) != B_OK)
+		return false;
+
+	// Matched case-insensitively, as query_for_app() does on its second pass.
+	return strcasecmp(foundSignature, signature) == 0;
+}
+
+
+/*!	Searches the standard application directories for an application with the
+	given \a signature.
+
+	The last resort when query_for_app() could not look anywhere. That function
+	only searches volumes that both know queries and carry a BEOS:APP_SIG
+	index, and skips every other volume deliberately -- so on a system booted
+	from a live ISO9660 session it searches nothing at all and reports
+	B_LAUNCH_FAILED_APP_NOT_FOUND.
+
+	That case is not hypothetical: app hints in the MIME database are written
+	when the image is built and name paths on the *build* machine, so they
+	never resolve on the booted system. Together, a stale hint and an
+	unqueryable boot volume made every signature-based launch fail on a live
+	medium -- which is how FirstBootPrompt, and with it the whole installer,
+	silently failed to appear while the desktop itself came up fine.
+
+	\a hintName, when not NULL and not empty, is the file name taken from the
+	stale app hint. It is tried directly in each directory first, which costs
+	a couple of stat() calls instead of a full directory scan in the case that
+	matters -- the hint's path is wrong, but its file name is not.
+*/
+static status_t
+find_app_in_standard_directories(const char* signature, const char* hintName,
+	entry_ref* appRef)
+{
+	if (signature == NULL || appRef == NULL)
+		return B_BAD_VALUE;
+
+	const directory_which kDirectories[] = {
+		B_SYSTEM_APPS_DIRECTORY,
+		B_SYSTEM_PREFERENCES_DIRECTORY,
+		B_SYSTEM_BIN_DIRECTORY,
+		B_SYSTEM_SERVERS_DIRECTORY,
+		B_SYSTEM_NONPACKAGED_BIN_DIRECTORY,
+		B_USER_APPS_DIRECTORY,
+		B_USER_NONPACKAGED_BIN_DIRECTORY,
+	};
+	const size_t kDirectoryCount
+		= sizeof(kDirectories) / sizeof(kDirectories[0]);
+
+	// The name from the stale hint, tried directly.
+	if (hintName != NULL && hintName[0] != '\0') {
+		for (size_t i = 0; i < kDirectoryCount; i++) {
+			BPath path;
+			if (find_directory(kDirectories[i], &path) != B_OK)
+				continue;
+			if (path.Append(hintName) != B_OK)
+				continue;
+
+			BEntry entry;
+			entry_ref ref;
+			if (entry.SetTo(path.Path(), true) != B_OK || !entry.IsFile()
+				|| entry.GetRef(&ref) != B_OK) {
+				continue;
+			}
+
+			if (app_has_signature(ref, signature)
+				&& can_app_be_used(&ref) == B_OK) {
+				*appRef = ref;
+				return B_OK;
+			}
+		}
+	}
+
+	// Otherwise scan them.
+	for (size_t i = 0; i < kDirectoryCount; i++) {
+		BPath path;
+		if (find_directory(kDirectories[i], &path) != B_OK)
+			continue;
+
+		BDirectory directory;
+		if (directory.SetTo(path.Path()) != B_OK)
+			continue;
+
+		entry_ref ref;
+		while (directory.GetNextRef(&ref) == B_OK) {
+			BEntry entry;
+			if (entry.SetTo(&ref, true) != B_OK || !entry.IsFile())
+				continue;
+
+			if (app_has_signature(ref, signature)
+				&& can_app_be_used(&ref) == B_OK) {
+				*appRef = ref;
+				return B_OK;
+			}
+		}
+	}
+
+	return B_LAUNCH_FAILED_APP_NOT_FOUND;
+}
+
