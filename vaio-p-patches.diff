+/*!	Takes the Poulsbo/SCH EHCI controller away from the BIOS before the AP is
+	woken, replicating the kernel's intel_fixup_ehci_bar() (pci_fixup.cpp) --
+	which runs at kernel PCI scan time, far too late for this purpose.
+
+	Why here: on the VAIO P the AP intermittently cannot be started, decided
+	per boot, and the boots that fail are exactly the boots where a ~200 ms
+	stall (an SMI storm; this thread simply stops executing) lands in the
+	INIT-to-SIPI window -- measured via the sliced spin in
+	smp_send_init_sipi(). This BIOS never acknowledges the EHCI legacy
+	handoff, so its USB legacy emulation is still armed and generating SMIs
+	throughout the loader's early wake. An SMI takes *both* logical processors
+	into SMM; an INIT/SIPI colliding with that is handled by firmware whose
+	idea of the sibling's state is its own business. Killing the BIOS's EHCI
+	claim and every one of its SMI enables before the first INIT removes that
+	collision at the source.
+
+	Gated to the SCH EHCI (8086:8117) found on bus 0, so it is a no-op
+	everywhere else. The SCH's UHCI companions (0x8114-0x8116) are left
+	strictly alone: they do not implement the standard USBLEGSUP register and
+	writing it corrupts their transfer engine (see the UHCI headline fix).
+*/
+static void
+smp_early_usb_handoff(void)
+{
+	// Never while the BIOS's own USB machinery still has work to do: booting
+	// from a USB stick, the loader reads the kernel via INT 13h *after* this
+	// point, and killing the BIOS's EHCI SMIs first broke exactly that on
+	// real hardware -- the very next partition scan read a bytes_per_sector
+	// of 0 and BIOSDrive::ReadAt() died on a divide error. Only an explicit
+	// EDD "ATA" answer for the boot drive makes this safe; anything else
+	// (USB, no EDD 3.0, no answer) skips.
+	if (!platform_boot_drive_is_ata()) {
+		dprintf("smp: early usb handoff skipped: boot drive is not ATA, the "
+			"BIOS's USB machinery may be load-bearing for INT 13h\n");
+		return;
+	}
+
+	for (uint8 device = 0; device < 32; device++) {
+		for (uint8 function = 0; function < 8; function++) {
+			uint32 id = pci_cfg_read(0, device, function, 0, 4);
+			if (id != 0x81178086)
+				continue;
+
+			uint32 bar0 = pci_cfg_read(0, device, function, 0x10, 4);
+			uint16 pciCommand = pci_cfg_read(0, device, function, 0x04, 2);
+			pci_cfg_write(0, device, function, 0x04, 2,
+				pciCommand | 0x02 /* memory decode */);
+
+			// EECP lives in MMIO HCCPARAMS bits 15:8; the capability
+			// registers themselves are in config space.
+			uint8 eecp = 0;
+			if ((bar0 & ~0xfffUL) != 0) {
+				addr_t regs = mmu_map_physical_memory(bar0 & ~0xfffUL,
+					B_PAGE_SIZE, kDefaultPageFlags);
+				if (regs != 0) {
+					uint32 hccparams = *(volatile uint32 *)(regs + 8);
+					eecp = (hccparams >> 8) & 0xff;
+				}
+			}
+			if (eecp < 0x40)
+				eecp = 0x68;	// SCH datasheet's fixed offset
+
+			uint32 legacySupport = pci_cfg_read(0, device, function, eecp, 4);
+			if ((legacySupport & 0xff) != 0x01) {
+				dprintf("smp: early usb handoff: no legacy capability at "
+					"%#02x (%#08" B_PRIx32 "), skipping\n", eecp,
+					legacySupport);
+				pci_cfg_write(0, device, function, 0x04, 2, pciCommand);
+				return;
+			}
+
+			bool wasBiosOwned = (legacySupport & (1 << 16)) != 0;
+			if (wasBiosOwned) {
+				// Ask politely first, but only briefly -- this BIOS has
+				// never once acknowledged, so the wait is a formality.
+				pci_cfg_write(0, device, function, eecp + 3, 1, 1);
+				for (int32 i = 0; i < 10; i++) {
+					legacySupport
+						= pci_cfg_read(0, device, function, eecp, 4);
+					if ((legacySupport & (1 << 16)) == 0)
+						break;
+					spin(5000);
+				}
+			}
+
+			// Force the BIOS semaphore off and disable/clear every SMI
+			// source regardless.
+			pci_cfg_write(0, device, function, eecp + 2, 1, 0);
+			pci_cfg_write(0, device, function, eecp + 4, 4, 0);
+			pci_cfg_write(0, device, function, 0x04, 2, pciCommand);
+
+			dprintf("smp: early usb handoff: EHCI at 0:%u:%u, was %s, SMI "
+				"enables cleared %" B_PRIu32 " ms before the wake\n",
+				device, function, wasBiosOwned
+					? ((legacySupport & (1 << 16)) != 0
+						? "BIOS-owned (forced off)" : "BIOS-owned (released)")
+					: "already unowned",
+				(uint32)(system_time() / 1000));
+			return;
+		}
+	}
+}
+
+#endif	// !_PXE_ENV
+
+
+/*!	Wakes the application processors as early as possible and parks them in the
+	trampoline, waiting for the page directory the BSP will publish later.
+
+	On the Sony VAIO P the window in which an AP can be started at all is only
+	a few seconds wide from power-on: measured on hardware, inserting a one
+	second delay before the SIPI still works while five seconds does not, and
+	after that the AP stops responding to INIT and SIPI entirely -- no error,
+	no execution, ten retries make no difference. Normal bring-up happens after
+	the kernel, its add-ons and (with load_symbols, which Haiku enables by
+	default) their symbols have all been read off the disk, which on this
+	machine lands well outside that window and silently costs the second CPU.
+
+	Waking them here instead only needs the gdt, whose contents are static, so
+	it can run long before the kernel exists. The AP reaches 32-bit protected
+	mode and then spins on the page directory slot; smp_boot_other_cpus() fills
+	that in later exactly as before, and the AP carries on. If this did not
+	take, that function still performs the full INIT/SIPI sequence itself, so
+	nothing depends on it having worked.
+*/
+void
+smp_wake_other_cpus_early(void)
+{
+	if (gKernelArgs.arch_args.apic_phys == 0 || gKernelArgs.num_cpus < 2)
+		return;
+
+	// Silence the BIOS's USB SMIs before the first INIT goes out -- see the
+	// function's comment for why this decides whether the AP starts at all.
+	smp_early_usb_handoff();
+
+	if (gKernelArgs.arch_args.apic == NULL) {
+		gKernelArgs.arch_args.apic = (void *)mmu_map_physical_memory(
+			gKernelArgs.arch_args.apic_phys, B_PAGE_SIZE, kDefaultPageFlags);
+	}
+
+	smp_setup_trampoline();
+
+	// Both handover slots must read zero: the AP waits on the page directory
+	// one, and the BSP later waits for the other to be cleared.
+	*(volatile uint32 *)(kTrampolineStack + B_PAGE_SIZE - 8) = 0;
+	*(volatile uint32 *)(kTrampolineStack + B_PAGE_SIZE - 4) = 0;
+	*(volatile uint32 *)kApParkedMarker = 0;
+	*(volatile uint32 *)kApRealModeMarker = 0;
+
+	// Read the local APIC back through the mapping this function just made,
+	// which is not the one smp_init_other_cpus() installs later. If the early
+	// mapping were wrong, every apic_read() below would be reading nothing,
+	// and a stuck delivery-status bit would be an artefact rather than a
+	// hardware fact.
+	uint32 apicId = apic_read(APIC_ID);
+	uint32 apicVersion = apic_read(APIC_VERSION);
+	uint32 apicSvr = apic_read(APIC_SPURIOUS_INTR_VECTOR);
+
+	// How far into the boot the SIPI actually goes out. The window in which
+	// this machine will start an AP is measured from power-on, and the TSC
+	// counts from power-on too, so this is the number that says whether the
+	// wake is inside the window or not. Capture before printing: dprintf()
+	// itself costs enough time to move the result.
+	uint64 tscAtWake;
+	asm volatile ("rdtsc" : "=A" (tscAtWake));
+	bigtime_t usDirectStart = system_time();
+
+	// A single delivery timeout used to abort the entire early wake with no
+	// SIPI sent and nothing in the log to say so, because the return value
+	// was thrown away. Retry, and report the outcome either way.
+	// Retry until the AP actually runs, not until the APIC says it sent.
+	//
+	// Measured over many boots: the local APIC always reports a clean send
+	// (0 us, esr 0x0) whether the AP comes up or not, so the send status says
+	// nothing. What does predict the outcome, perfectly, is whether a ~200 ms
+	// stall lands inside the 10 ms INIT-to-SIPI wait. Boots with the stall
+	// never bring the AP up; boots without it always do. The stall is this
+	// thread being held off -- an SMI, on a machine whose BIOS never
+	// acknowledges the EHCI legacy handoff and so is still running USB legacy
+	// emulation on SMIs -- and an SMI takes both logical processors into SMM
+	// together, where a SIPI is discarded rather than latched. So the SIPI is
+	// simply lost when it happens to be sent around one.
+	//
+	// It is intermittent, roughly one boot in two, so the fix is to notice and
+	// try again: send INIT/SIPI, give the AP a couple of milliseconds, and
+	// check its own real-mode marker. Repeating SIPIs alone does not work
+	// (measured: 50 of them over 5 seconds, no response) -- the AP needs the
+	// whole INIT/SIPI sequence again.
+	// The BIOS warm-reset vector, set the way Linux always has
+	// (smpboot_setup_warm_reset_vector): CMOS shutdown-status 0x0a plus a
+	// real-mode far pointer to the trampoline at 40:67. On the IPI path the
+	// SIPI vector makes this redundant -- but on this machine's bad boots the
+	// AP is being held by firmware (the SMI-shaped stalls on the BSP are the
+	// visible half of that), and an AP that firmware routes back through the
+	// BIOS's own reset path never sees a SIPI vector at all: the BIOS reads
+	// the shutdown status, and 0x0a means "jump via 40:67 without POST".
+	// This pointer is the only door into that path.
+	//
+	// The change log claims this was tried on 2026-08-18 and dropped, but
+	// those loaders fell inside the HAIKU_TOP build-trap window (see "A build
+	// trap that invalidated two experiments"), so it was likely never
+	// actually executed.
+	//
+	// The 0x0a MUST be cleared before anything can reboot the machine --
+	// including this function's own reroll below -- or the next warm reset
+	// jumps through a stale pointer instead of POSTing.
+	out8(0x0f, 0x70);
+	out8(0x0a, 0x71);
+	*(volatile uint16 *)0x467 = (uint16)(kTrampolineCode & 0xf);	// offset
+	*(volatile uint16 *)0x469 = (uint16)(kTrampolineCode >> 4);	// segment
+
+	const uint32 kEarlyWakeAttempts = 10;
+	bool sent = false;
+	uint32 attempt;
+	for (attempt = 1; attempt <= kEarlyWakeAttempts; attempt++) {
+		sStallSliceCount = 0;
+
+		sent = true;
+		for (uint32 i = 1; i < gKernelArgs.num_cpus; i++) {
+			if (!smp_send_init_sipi(i))
+				sent = false;
+		}
+
+		spin(2000);
+
+		if (*(volatile uint32 *)kApRealModeMarker != 0)
+			break;
+
+		sStalledAttempts += sStallSliceCount != 0 ? 1 : 0;
+	}
+
+	// Give the firmware-mediated path a moment beyond the IPI one: if the AP
+	// comes back through the BIOS and the 40:67 pointer, it does so on the
+	// firmware's schedule, not within the 2 ms the loop above waits.
+	if (*(volatile uint32 *)kApRealModeMarker == 0) {
+		for (uint32 waited = 0; waited < 500; waited += 10) {
+			spin(10000);
+			if (*(volatile uint32 *)kApRealModeMarker != 0)
+				break;
+		}
+	}
+
+	// Disarm the warm-reset shortcut before anything can reboot.
+	out8(0x0f, 0x70);
+	out8(0x00, 0x71);
+
+	bigtime_t usDirectEnd = system_time();
+	uint64 tscAfter;
+	asm volatile ("rdtsc" : "=A" (tscAfter));
+
+	// Use the loader's PIT-calibrated clock, not an assumed clock rate: an
+	// earlier version divided by a hand-picked 1.33 GHz and reported a SIPI
+	// sequence of 208 ms where the code's own spins account for about 10,
+	// which is what exposed the error.
+	uint64 usNow = (uint64)system_time();
+	uint32 msAtWake = (uint32)(((tscAtWake * usNow / tscAfter)) / 1000ULL);
+	uint32 msAfter = (uint32)(usNow / 1000ULL);
+
+	dprintf("smp: early wake sent to %" B_PRIu32 " ap(s) at %" B_PRIu32
+		" ms after power-on (took %" B_PRIu32 " ms, sequence %s, attempt %"
+		B_PRIu32 " of %" B_PRIu32 ", %" B_PRIu32 " spoiled by a stall)\n",
+		gKernelArgs.num_cpus - 1, msAtWake, msAfter - msAtWake,
+		sent ? "completed" : "ABORTED", attempt > kEarlyWakeAttempts
+			? kEarlyWakeAttempts : attempt, kEarlyWakeAttempts,
+		sStalledAttempts);
+
+	// The reroll. Whether the AP can be started at all is decided by the
+	// firmware before the loader ever runs: across every instrumented boot,
+	// a boot whose wake attempts see the ~200 ms stall never brings the AP
+	// up and a boot without it always does, with no exception. Nothing
+	// software-side has changed a bad boot into a good one -- not 10 full
+	// INIT/SIPI sequences here, not 50 extra SIPIs, not the kernel's own 3
+	// attempts seconds later, not clearing the EHCI legacy SMI enables
+	// before the first INIT (tried; the stall and the failures persisted).
+	// What does change the outcome is another POST: the state re-rolls per
+	// boot at usable odds.
+	//
+	// So when the AP has not answered, reboot on purpose and roll again.
+	// The counter lives in the RTC alarm-seconds CMOS byte: it survives a
+	// warm reset, it is not part of the checksummed BIOS setup area (which
+	// this machine could not even re-configure, having no setup UI), and
+	// nothing in this system arms RTC alarms. A magic high nibble keeps a
+	// stale byte from a previous OS from being mistaken for a count.
+	{
+		const uint8 kRerollCmosIndex = 0x01;	// RTC alarm seconds
+		const uint8 kRerollMagic = 0xa0;
+		const uint8 kMaxRerolls = 8;
+			// Was 3. The odds per boot are not fixed -- runs of six or more
+			// consecutive stalled boots have been observed -- so a budget of
+			// three retires the only mechanism that works while the machine
+			// is still perfectly capable of coming up with both CPUs on the
+			// next roll. Each roll costs one POST, about thirty seconds, and
+			// the payoff on a build machine is +39% for however long it then
+			// stays up, so spending a few more is clearly worth it.
+			//
+			// Note the counter is sticky: once it reaches the maximum the
+			// mechanism stops for good until something resets the byte, which
+			// is exactly the state this machine was found in -- three rolls
+			// spent days ago and no further attempts since.
+
+		out8(kRerollCmosIndex, 0x70);
+		uint8 cmos = in8(0x71);
+		uint8 rerolls = (cmos & 0xf0) == kRerollMagic ? (cmos & 0x0f) : 0;
+
+		bool apAnswered = *(volatile uint32 *)kApRealModeMarker != 0;
+		if (apAnswered) {
+			if (rerolls != 0) {
+				dprintf("smp: early wake: AP came up after %u deliberate "
+					"reboot(s) re-rolling the firmware state\n", rerolls);
+			}
+			out8(kRerollCmosIndex, 0x70);
+			out8(0, 0x71);
+		} else if (rerolls < kMaxRerolls) {
+			out8(kRerollCmosIndex, 0x70);
+			out8(kRerollMagic | (rerolls + 1), 0x71);
+			dprintf("smp: early wake: AP unresponsive, rebooting to re-roll "
+				"the firmware state (reroll %u of %u)\n", rerolls + 1,
+				kMaxRerolls);
+			spin(50000);	// let serial output drain
+
+			// The coldest reset available first: a KBC-pulse warm reset
+			// demonstrably carries the bad state along -- measured, one
+			// give-up after 3 straight failed rerolls, in line with the
+			// evening's 7-of-8 warm-reboot failure streak. RST_CNT (port
+			// 0xcf9) with FULL_RST set is as close to a power cycle as
+			// software gets here; the KBC pulse stays as the fallback for
+			// the case where this chipset ignores 0xcf9.
+			out8(0x02, 0xcf9);
+			spin(500);
+			out8(0x0e, 0xcf9);
+			spin(100000);
+			out8(0xfe, 0x64);	// keyboard-controller pulse, as platform_exit()
+			for (;;)
+				asm volatile ("hlt");
+		} else {
+			dprintf("smp: early wake: AP unresponsive after %u reroll(s), "
+				"continuing with one CPU\n", rerolls);
+			out8(kRerollCmosIndex, 0x70);
+			out8(0, 0x71);
+		}
+	}
+
+	dprintf("smp:   local apic at %p: id %#" B_PRIx32 ", version %#" B_PRIx32
+		", svr %#" B_PRIx32 " (%s)\n", (void *)gKernelArgs.arch_args.apic,
+		apicId,
+		apicVersion, apicSvr,
+		(apicSvr & APIC_ENABLE) != 0 ? "enabled" : "SOFTWARE-DISABLED");
+
+	for (uint32 i = 0; i < sIpiTraceCount; i++) {
+		dprintf("smp:   ipi %s: wrote icr1 %#" B_PRIx32 ", waited %" B_PRIu32
+			" us%s, icr1 now %#" B_PRIx32 ", esr %#" B_PRIx32 "\n",
+			sIpiTrace[i].name, sIpiTrace[i].writtenIcr,
+			sIpiTrace[i].elapsedUs, sIpiTrace[i].timedOut ? " (TIMED OUT)" : "",
+			sIpiTrace[i].readbackIcr, sIpiTrace[i].esr);
+	}
+
+	// Where the ~200 ms actually goes. These segments tile the whole of
+	// smp_send_init_sipi(), so they have to add up to the figure above; the
+	// one that does not match its nominal cost is the answer. usDirect is the
+	// same interval measured straight off system_time() instead of through the
+	// TSC ratio, as a check that the ratio arithmetic is not itself the bug.
+	uint32 segmentTotal = 0;
+	for (uint32 i = 0; i < 12; i++)
+		segmentTotal += sSegmentUs[i];
+
+	dprintf("smp:   segments (us): total %" B_PRIu32 ", direct %" B_PRIu32
+		"\n", segmentTotal, (uint32)(usDirectEnd - usDirectStart));
+	for (uint32 i = 0; i < 12; i++) {
+		if (sSegmentUs[i] != 0) {
+			dprintf("smp:     %s %" B_PRIu32 " us\n", kSegmentName[i],
+				sSegmentUs[i]);
+		}
+	}
+
+	// Read the markers here, milliseconds after the SIPI, rather than only in
+	// smp_boot_other_cpus() several seconds and one whole kernel load later.
+	// If the AP does run, this is where it shows -- and a marker that is set
+	// here but zero there means the 0x9e000 page was overwritten in between,
+	// not that the AP never started.
+	spin(5000);
+	dprintf("smp:   markers 5 ms after the wake: real-mode %#" B_PRIx32
+		", pmode %#" B_PRIx32 "\n", *(volatile uint32 *)kApRealModeMarker,
+		*(volatile uint32 *)kApParkedMarker);
+
+	// The 200 ms is entirely inside the one spin(10000) that follows the INIT
+	// de-assert: measured 210496 us for a 10 ms request, while both spin(200)
+	// calls in the same sequence come back at exactly 200 us. A spin cannot
+	// overshoot by 20x on its own -- it polls the same clock it is measured
+	// with -- so either the clock jumped or the thread did not execute for
+	// 200 ms. Both are things that happen to a thread whose sibling has just
+	// been sent an INIT.
+	//
+	// Three measurements separate the possibilities, all after the real wake
+	// so none of them moves the SIPI:
+	//   baseline   -- a 10 ms spin with no IPI anywhere near it. If this is
+	//                 already 210 ms, the cost is periodic (an SMI storm from
+	//                 the USB legacy emulation this BIOS never hands off) and
+	//                 has nothing to do with the INIT.
+	//   after-absent -- a 10 ms spin right after an INIT aimed at an APIC id
+	//                 that cannot exist. Isolates "sending any INIT is
+	//                 expensive" from "reaching that particular target is".
+	//   after-real -- the same right after an INIT aimed at id 1. If only this
+	//                 one costs 200 ms, then something IS there receiving it,
+	//                 which is the opposite of what every other measurement so
+	//                 far suggests.
+	sEarlyWakeAttempt
+		= attempt > kEarlyWakeAttempts ? kEarlyWakeAttempts : attempt;
+	sEarlyWakeMaxAttempts = kEarlyWakeAttempts;
+
+	if (sStallSliceCount != 0) {
+		for (uint32 i = 0; i < sStallSliceCount; i++) {
+			dprintf("smp:   stall: slice %" B_PRIu32 " of 20 took %" B_PRIu32
+				" us\n", sStallSlice[i], sStallSliceUs[i]);
+		}
+	}
+
+
+}
