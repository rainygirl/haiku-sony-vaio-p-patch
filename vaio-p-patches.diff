+static const uint32 kTrampolineCode  = 0x8b000;
+static const uint32 kTrampolineStack = 0x8c000;
+#else
+static const uint32 kTrampolineCode  = 0x9f000;
+static const uint32 kTrampolineStack = 0x9e000;
+#endif
+
+// Written by the trampoline once it reaches 32-bit protected mode; lets the
+// BSP tell "already parked, just hand over the page directory" from "never
+// started, run the whole INIT/SIPI sequence".
+static const uint32 kApParkedMarker = 0x9e804;
+
+// Written by the trampoline's first real-mode instructions. Distinguishes
+// "the AP never executed anything at all" (the documented out-of-window
+// behaviour) from "it ran but did not reach protected mode".
+static const uint32 kApRealModeMarker = 0x9e808;
+
