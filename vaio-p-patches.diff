diff --git a/src/system/kernel/fs/vfs_boot.cpp b/src/system/kernel/fs/vfs_boot.cpp
index 45e7fb785a..277f055149 100644
--- a/src/system/kernel/fs/vfs_boot.cpp
+++ b/src/system/kernel/fs/vfs_boot.cpp
@@ -477,6 +477,25 @@ vfs_mount_boot_file_system(kernel_args* args)
 	if (status < B_OK) {
 		panic("get_boot_partitions failed!");
 	}
+
+	// 10 seconds wasn't always enough on hardware whose USB host controller
+	// needs multiple halt/recovery cycles (each with its own settle delays)
+	// before the boot device's own enumeration gets a chance to complete --
+	// e.g. an unrelated device sharing the same controller repeatedly
+	// halting it during early boot, with each recovery attempt, port
+	// power-cycle, and cooldown-based rearm adding several more seconds on
+	// top of each other. Give it up to a minute before concluding the boot
+	// device really isn't going to show up.
+	const int32 kBootPartitionRetries = 240;
+	const bigtime_t kBootPartitionRetryInterval = 250000;
+	for (int32 i = 0; partitions.IsEmpty() && i < kBootPartitionRetries; i++) {
+		snooze(kBootPartitionRetryInterval);
+		status = get_boot_partitions(bootVolume, partitions);
+		if (status < B_OK) {
+			panic("get_boot_partitions failed!");
+		}
+	}
+
 	if (partitions.IsEmpty()) {
 		panic("did not find any boot partitions! @! syslog | tail 15");
 	}
