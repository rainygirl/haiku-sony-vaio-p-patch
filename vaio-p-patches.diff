+/*!	Whether the drive the BIOS booted us from is an ATA device.
+
+	smp_early_usb_handoff() needs this: taking USB away from the BIOS is only
+	safe when the BIOS's USB machinery is not what INT 13h is reading the boot
+	volume through. Booting from a USB stick it is, so the handoff is skipped
+	and the AP wake has to live with the BIOS perturbing its timing.
+*/
+bool
+platform_boot_drive_is_ata(void)
+{
+	drive_parameters parameters;
+
+	if (gBootDriveID < 0x80
+		|| !are_extensions_available(gBootDriveID)
+		|| get_ext_drive_parameters(gBootDriveID, &parameters) != B_OK)
+		return false;
+
+	if (parameters.parameters_size < kParametersSizeVersion3
+		|| parameters.device_path_signature != kDevicePathSignature)
+		return false;
+
+	return strncmp(parameters.interface_type, "ATA", 3) == 0;
+}
