+			if (command.transfer.status == B_OK)
+				status = B_OK;
+			if (user_memcpy(command.isochronous.packet_descriptors,
+					packetDescriptors, descriptorsSize) != B_OK) {
+				status = B_BAD_ADDRESS;
+			}
+
+			break;
+		}
+
+		case B_USB_RAW_COMMAND_QUEUE_ISOCHRONOUS:
+		{
+			if (length < sizeof(command.isochronous))
+				return B_BUFFER_OVERFLOW;
+
+			status = B_OK;
+			const usb_configuration_info *configurationInfo =
+				gUSBModule->get_configuration(device->device);
+			if (configurationInfo == NULL) {
+				command.transfer.status = B_USB_RAW_STATUS_INVALID_CONFIGURATION;
+				break;
+			}
+
+			if (command.transfer.interface >= configurationInfo->interface_count) {
+				command.transfer.status = B_USB_RAW_STATUS_INVALID_INTERFACE;
+				break;
+			}
+
+			const usb_interface_info *interfaceInfo =
+				configurationInfo->interface[command.transfer.interface].active;
+			if (interfaceInfo == NULL) {
+				command.transfer.status = B_USB_RAW_STATUS_ABORTED;
+				break;
+			}
+
+			if (command.transfer.endpoint >= interfaceInfo->endpoint_count) {
+				command.transfer.status = B_USB_RAW_STATUS_INVALID_ENDPOINT;
+				break;
+			}
+
+			const usb_endpoint_info *endpointInfo =
+				&interfaceInfo->endpoint[command.transfer.endpoint];
+			if (!endpointInfo->handle) {
+				command.transfer.status = B_USB_RAW_STATUS_INVALID_ENDPOINT;
+				break;
+			}
+
+			size_t descriptorsSize = sizeof(usb_iso_packet_descriptor)
+				* command.isochronous.packet_count;
+			usb_iso_packet_descriptor *packetDescriptors
+				= (usb_iso_packet_descriptor *)malloc(descriptorsSize);
+			if (packetDescriptors == NULL) {
+				command.transfer.status = B_USB_RAW_STATUS_NO_MEMORY;
+				command.transfer.length = 0;
+				break;
+			}
+			MemoryDeleter descriptorsDeleter(packetDescriptors);
+
+			if (!IS_USER_ADDRESS(command.isochronous.data)
+				|| !IS_USER_ADDRESS(command.isochronous.packet_descriptors)
+				|| user_memcpy(packetDescriptors,
+					command.isochronous.packet_descriptors,
+					descriptorsSize) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+
+			int slotIndex = -1;
+			mutex_lock(&device->isoSlotLock);
+			for (int i = 0; i < USB_RAW_ISO_SLOT_COUNT; i++) {
+				if (!device->isoSlots[i].in_use) {
+					device->isoSlots[i].in_use = true;
+					slotIndex = i;
+					break;
 				}
 			}
+			mutex_unlock(&device->isoSlotLock);
+
+			if (slotIndex < 0) {
+				// Every slot already has a request outstanding -- the
+				// caller must WAIT_ISOCHRONOUS on one of its existing
+				// requests before queuing another.
+				command.transfer.status = B_USB_RAW_STATUS_FAILED;
+				command.transfer.length = 0;
+				command.isochronous.request_id = -1;
+				break;
+			}
+
+			iso_slot *slot = &device->isoSlots[slotIndex];
+			slot->packetDescriptors = packetDescriptors;
+			slot->userPacketDescriptors = command.isochronous.packet_descriptors;
+			slot->descriptorsSize = descriptorsSize;
+			slot->endpointHandle = endpointInfo->handle;
+
+			status_t submitStatus = gUSBModule->queue_isochronous(
+				endpointInfo->handle, command.isochronous.data,
+				command.isochronous.length, packetDescriptors,
+				command.isochronous.packet_count, NULL, 0,
+				usb_raw_iso_callback, slot);
+
+			if (submitStatus < B_OK) {
+				command.transfer.status = B_USB_RAW_STATUS_FAILED;
+				command.transfer.length = 0;
+				command.isochronous.request_id = -1;
+				mutex_lock(&device->isoSlotLock);
+				slot->in_use = false;
+				mutex_unlock(&device->isoSlotLock);
+				break;
+			}
+
+			// Ownership of packetDescriptors now belongs to the slot
+			// (freed at WAIT_ISOCHRONOUS time, once the transfer using
+			// it has actually completed) -- don't free it when this
+			// scope exits.
+			descriptorsDeleter.Detach();
+
+			command.transfer.status = B_USB_RAW_STATUS_SUCCESS;
+			command.isochronous.request_id = slotIndex;
+			break;
+		}
+
+		case B_USB_RAW_COMMAND_WAIT_ISOCHRONOUS:
+		{
+			if (length < sizeof(command.isochronous))
+				return B_BUFFER_OVERFLOW;
+
+			status = B_OK;
+			int32 slotIndex = command.isochronous.request_id;
+			if (slotIndex < 0 || slotIndex >= USB_RAW_ISO_SLOT_COUNT
+				|| !device->isoSlots[slotIndex].in_use) {
+				command.transfer.status = B_USB_RAW_STATUS_INVALID_ENDPOINT;
+				break;
+			}
+
+			iso_slot *slot = &device->isoSlots[slotIndex];
+			status = acquire_sem_etc(slot->notify, 1, B_KILL_CAN_INTERRUPT, 0);
+			if (status != B_OK) {
+				gUSBModule->cancel_queued_transfers(slot->endpointHandle);
+				acquire_sem(slot->notify);
+			}
+
+			command.transfer.status = slot->status;
+			command.transfer.length = slot->actual_length;
+
+			if (command.transfer.status == B_OK)
+				status = B_OK;
+			if (user_memcpy(slot->userPacketDescriptors,
+					slot->packetDescriptors, slot->descriptorsSize) != B_OK) {
+				status = B_BAD_ADDRESS;
+			}
+
+			free(slot->packetDescriptors);
+			slot->packetDescriptors = NULL;
+
+			mutex_lock(&device->isoSlotLock);
+			slot->in_use = false;
+			mutex_unlock(&device->isoSlotLock);
 
 			break;
 		}
diff --git a/src/add-ons/kernel/drivers/bus/usb/usb_raw.h b/src/add-ons/kernel/drivers/bus/usb/usb_raw.h
index 9968fa825e..0122e5a55e 100644
--- a/src/add-ons/kernel/drivers/bus/usb/usb_raw.h
+++ b/src/add-ons/kernel/drivers/bus/usb/usb_raw.h
@@ -37,7 +37,26 @@ typedef enum {
 	B_USB_RAW_COMMAND_CONTROL_TRANSFER = 0x4000,
 	B_USB_RAW_COMMAND_INTERRUPT_TRANSFER,
 	B_USB_RAW_COMMAND_BULK_TRANSFER,
-	B_USB_RAW_COMMAND_ISOCHRONOUS_TRANSFER
+	B_USB_RAW_COMMAND_ISOCHRONOUS_TRANSFER,
+
+	// Submit-then-wait split of ISOCHRONOUS_TRANSFER: QUEUE returns
+	// immediately with isochronous.request_id identifying the request
+	// (instead of blocking for completion like ISOCHRONOUS_TRANSFER
+	// does), and a later WAIT call (passing that same request_id back in)
+	// blocks for that specific request's completion and fills in the
+	// result fields exactly like ISOCHRONOUS_TRANSFER would have. This
+	// lets one caller have two isochronous transfers genuinely
+	// outstanding at once -- submit both, then wait on each in turn --
+	// which matters for isochronous IN specifically: the host controller
+	// can schedule a second submission to start immediately where the
+	// first one's schedule range ends only if it's queued before the
+	// first completes (see EHCI::SubmitIsochronous's fNextStartingFrame
+	// chaining); waiting for each transfer to fully finish before
+	// queuing the next guarantees a scheduling gap between every pair of
+	// submissions, during which an isochronous IN device keeps
+	// transmitting into microframes nothing was scheduled to receive.
+	B_USB_RAW_COMMAND_QUEUE_ISOCHRONOUS,
+	B_USB_RAW_COMMAND_WAIT_ISOCHRONOUS
 } usb_raw_command_id;
 
 
@@ -182,6 +201,10 @@ typedef union {
 		size_t							length;
 		usb_iso_packet_descriptor		*packet_descriptors;
 		uint32							packet_count;
+		// Only used by QUEUE_ISOCHRONOUS (out: identifies this request)
+		// and WAIT_ISOCHRONOUS (in: which request to wait for). Unused
+		// by the plain (submit-and-block) ISOCHRONOUS_TRANSFER.
+		int32							request_id;
 	} isochronous;
 } usb_raw_command;
 
