+/*!	Whether EDD reports the boot drive on an ATA interface.
+
+	Exists for one caller: the loader's pre-wake EHCI BIOS handoff
+	(smp_early_usb_handoff() in smp.cpp), which must never run when the boot
+	medium is read through the BIOS's own USB machinery -- killing the BIOS's
+	USB SMIs while it still had INT 13h reads to serve broke the very next
+	partition scan on real hardware (bytes_per_sector came back 0 and
+	BIOSDrive::ReadAt() died on a divide error, "Boot Loader Death Land").
+	Only an explicit EDD 3.0 answer of "ATA" (which also covers ATAPI)
+	counts; USB, anything else, or any failure to answer means "not safe",
+	so the default is to skip.
+
+	Uses only gBootDriveID (set by shell.S from DL before any C code) and a
+	BIOS call, so it is safe long before platform device init.
+*/
+extern "C" bool
+platform_boot_drive_is_ata(void)
+{
+	drive_parameters parameters;
+
+	if (gBootDriveID < 0x80
+		|| !are_extensions_available(gBootDriveID)
+		|| get_ext_drive_parameters(gBootDriveID, &parameters) != B_OK)
+		return false;
+
+	if (parameters.parameters_size < kParametersSizeVersion3
+		|| parameters.device_path_signature != kDevicePathSignature)
+		return false;
+
+	return strncmp(parameters.interface_type, "ATA", 3) == 0;
+}
