+void
+ModifiedPageQueue::_ReconcileAndNotify()
+{
+	// IsOverQuota() is the only place this queue's contribution to the global
+	// counters is reconciled, so it has to be called on every pass of the
+	// writer loop, including the passes that find nothing to write. A queue
+	// that drains and is then never queried again leaves its last estimate in
+	// sGlobalEstimatedWriteDuration for good, and once the stale total exceeds
+	// the global quota every queue is over quota forever: waiters block in
+	// WaitIfOverQuota() and no writer ever reaches the notify below, because
+	// its own IsOverQuota() is false for exactly the same reason.
+	if (!IsOverQuota())
+		sUnderQuotaCondition.NotifyAll();
+}
