+/*!	Makes sure a join that fails is noticed even when nothing else happens.
+
+	The retry above only runs when a scan completes, and a failed join can
+	leave nothing scanning: measured on the VAIO P, wpa_supplicant gave up on
+	an authentication that got no answer, the interface went AUTH -> INIT, and
+	no scan -- so no retry -- followed for as long as the machine stayed up.
+	So every join also arms a one-shot check for just after its grace period.
+	If there is no link by then, it asks for a scan, and the scan's
+	completion runs the retry, with its backoff, exactly as if the scan had
+	happened on its own. A scan rather than a join, because net_server only
+	joins networks it can see in the scan results, and an interface that fell
+	back to INIT may have none left.
+*/
+void
+AutoconfigLooper::_ArmJoinCheck()
+{
+	delete fJoinCheckRunner;
+	fJoinGeneration++;
+
+	BMessage check(kMsgJoinCheck);
+	check.AddInt32("generation", fJoinGeneration);
+	fJoinCheckRunner = new(std::nothrow) BMessageRunner(BMessenger(this),
+		&check, fJoinNetworkRetryTimeout + 1000000, 1);
+}
+
+
+void
+AutoconfigLooper::_JoinCheck(BMessage* message)
+{
+	int32 generation;
+	if (message->FindInt32("generation", &generation) != B_OK
+		|| generation != fJoinGeneration) {
+		// A later join has armed its own check.
+		return;
+	}
+
+	if ((fLastMediaStatus & IFM_ACTIVE) != 0)
+		return;
+
+	BNetworkDevice device(fDevice.String());
+	status_t status = device.Scan(false, true);
+	syslog(LOG_NOTICE, "net_server: %s: no link %" B_PRIdBIGTIME " s after "
+		"joining, requesting a scan to retry: %s\n", fDevice.String(),
+		fJoinNetworkRetryTimeout / 1000000, strerror(status));
+	if (status != B_OK) {
+		// The device could not scan right now; look again one maximum
+		// grace period later rather than giving up on it.
+		delete fJoinCheckRunner;
+		BMessage check(kMsgJoinCheck);
+		check.AddInt32("generation", fJoinGeneration);
+		fJoinCheckRunner = new(std::nothrow) BMessageRunner(BMessenger(this),
+			&check, kJoinNetworkRetryTimeoutMax, 1);
+	}
+}
