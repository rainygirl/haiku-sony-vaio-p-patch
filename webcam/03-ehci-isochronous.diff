-										bool directionIn, addr_t bufferPhy,
-										void *bufferLog, size_t bufferSize);
+										uint32 firstFrame, bool directionIn,
+										addr_t bufferPhy, void *bufferLog,
+										size_t bufferSize);
 		status_t					CancelAllPendingTransfers();
 
 
